<Page x:Class="_5_Jahre_Hoelle.pages.Game"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_5_Jahre_Hoelle.pages"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="Game"
      KeyDown="Page_KeyDown"
      KeyUp="Page_KeyUp"
      Focusable="True">

    <Canvas x:Name="CanvasTotalGamescreen" Background="LightCyan" Height="1080" Width="1920">
        <Canvas x:Name="CanvasGame" Height="840" Width="1680" Background="Aquamarine" Canvas.Left="120" Canvas.Top="96">
            <TextBlock x:Name="TxtShopHint" Text="Press E to open shop" FontSize="28" FontWeight="Bold" Foreground="White" Background="Black" Padding="10" Visibility="Collapsed" Canvas.Left="20" Canvas.Top="20"/>
            <Rectangle Panel.ZIndex="2" Name="Rect_Player" Stroke="Black" StrokeThickness="0" Fill="Gray" Width="72" Height="100" Canvas.Top="370" Canvas.Left="804" HorizontalAlignment="Left" VerticalAlignment="Top"></Rectangle>
        </Canvas>



    </Canvas>
</Page>
