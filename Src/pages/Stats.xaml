<Page x:Class="_5_Jahre_Hoelle.pages.Stats"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_5_Jahre_Hoelle.pages"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="Stats">

    <!-- ChatGPT Anfang: mach das die labels richtig geil aussehen die schrift wäre nice wenn es so pixelart mässig wäre also den code halt ändern kein bilder erstellen -->
    <Page.Resources>
        <Style x:Key="PixelStatsLabel" TargetType="Label">
            <Setter Property="Panel.ZIndex" Value="99"/>
            <Setter Property="Width" Value="682"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Lucida Console"/>
            <Setter Property="Foreground" Value="#FF2A1605"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FFD9B45F" Direction="315" ShadowDepth="2" BlurRadius="0" Opacity="1"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <!-- ChatGPT Ende -->

    <Canvas x:Name="Canva_Stats">
        <Image Source="/assets/Stats.png"
       Width="1920"
       Height="1080"
       Stretch="Fill"
       Canvas.Left="0"
       Canvas.Top="0"/>

        <!-- ChatGPT Anfang: mach das die labels richtig geil aussehen die schrift wäre nice wenn es so pixelart mässig wäre also den code halt ändern kein bilder erstellen -->
        <Label Name="Label_attemps" Style="{StaticResource PixelStatsLabel}" Content="ATTEMPS: " Canvas.Left="619" Canvas.Top="360"></Label>
        <Label Name="Label_Wins" Style="{StaticResource PixelStatsLabel}" Content="WINS: " Canvas.Left="619" Canvas.Top="458"></Label>
        <Label Name="Label_acheavments" Style="{StaticResource PixelStatsLabel}" Content="ACHIEVMENTS: " Canvas.Left="619" Canvas.Top="556"></Label>
        <!-- ChatGPT Ende -->

        <Button Name="Button_Zurück" Content="Button" Canvas.Left="1333" Opacity="0" Click="Button_Zurück_Click" MouseEnter="Button_Zurück_MouseEnter" MouseLeave="Button_Zurück_MouseLeave" Canvas.Top="846" Height="41" Width="112" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        <Line Name="Line_Zurück" X1="100" X2="200" Y1="200" Y2="200" Stroke="Black" StrokeThickness="3" Opacity="0" Canvas.Left="1236" Canvas.Top="686"></Line>
    </Canvas>
</Page>