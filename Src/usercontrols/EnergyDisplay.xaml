<UserControl x:Class="_5_Jahre_Hoelle.usercontrols.EnergyDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:_5_Jahre_Hoelle.usercontrols"
             mc:Ignorable="d" 
             d:DesignHeight="90" d:DesignWidth="280"
             Width="280"
             Height="90">

    <!-- chatgpt anfang: mach mir eine Energy anzeige in dem style (code von Grade_uc) mit einer Progress bar -->
    <Canvas Width="280" Height="90">

        <Rectangle Width="280"
                   Height="90"
                   Fill="SaddleBrown"
                   Stroke="Black"
                   StrokeThickness="4"/>

        <Rectangle Width="270"
                   Height="6"
                   Canvas.Left="5"
                   Canvas.Top="5"
                   Fill="Peru"/>

        <Rectangle Width="6"
                   Height="80"
                   Canvas.Left="5"
                   Canvas.Top="5"
                   Fill="Peru"/>

        <Rectangle Width="270"
                   Height="6"
                   Canvas.Left="5"
                   Canvas.Top="79"
                   Fill="Sienna"/>

        <Rectangle Width="6"
                   Height="80"
                   Canvas.Left="269"
                   Canvas.Top="5"
                   Fill="Sienna"/>

        <Rectangle Width="252"
                   Height="62"
                   Canvas.Left="14"
                   Canvas.Top="14"
                   Fill="DarkGreen"
                   Stroke="Black"
                   StrokeThickness="3"/>

        <Rectangle Width="28"
                   Height="3"
                   Canvas.Left="35"
                   Canvas.Top="25"
                   Fill="White"
                   Opacity="0.25"/>

        <Rectangle Width="40"
                   Height="3"
                   Canvas.Left="180"
                   Canvas.Top="62"
                   Fill="White"
                   Opacity="0.15"/>

        <Rectangle Width="18"
                   Height="3"
                   Canvas.Left="220"
                   Canvas.Top="34"
                   Fill="White"
                   Opacity="0.15"/>

        <Label x:Name="EnergyText"
               Content="ENERGY"
               Canvas.Left="24"
               Canvas.Top="18"
               FontSize="24"
               FontWeight="Bold"
               FontFamily="Lucida Console"
               Foreground="White"
               Padding="0"/>

        <Label x:Name="EnergyNumber"
               Content="100"
               Canvas.Left="205"
               Canvas.Top="18"
               FontSize="24"
               FontWeight="Bold"
               FontFamily="Lucida Console"
               Foreground="White"
               Padding="0"/>

        <Rectangle Width="220"
                   Height="18"
                   Canvas.Left="30"
                   Canvas.Top="52"
                   Fill="Black"
                   Stroke="White"
                   StrokeThickness="2"/>

        <Rectangle x:Name="EnergyBar"
                   Width="216"
                   Height="10"
                   Canvas.Left="32"
                   Canvas.Top="56"
                   Fill="Green"/>

        <Rectangle Width="80"
                   Height="2"
                   Canvas.Left="40"
                   Canvas.Top="58"
                   Fill="White"
                   Opacity="0.35"/>

        <Rectangle Width="35"
                   Height="2"
                   Canvas.Left="150"
                   Canvas.Top="63"
                   Fill="White"
                   Opacity="0.25"/>

    </Canvas>
    <!-- chatgpt ende -->
</UserControl>