<Window x:Class="_5_Jahre_Hoelle.subwindows.question_ask"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_5_Jahre_Hoelle.subwindows"
        mc:Ignorable="d"
        Title="question_ask"
        Height="475"
        Width="815"
        Background="DarkGreen">

    <Canvas>

        <!-- Frage -->
        <Border Height="120"
                Width="780"
                Canvas.Left="10"
                Canvas.Top="10"
                Background="SaddleBrown"
                BorderBrush="Black"
                BorderThickness="1"
                CornerRadius="30"
                x:Name="Rect_Frage">

            <Grid>
                <TextBlock x:Name="Txt_Frage"
                           Text="Was ist 2 + 2?"
                           Foreground="White"
                           FontSize="28"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="20"/>
            </Grid>
        </Border>

        <!-- Antwort 1 -->
        <Border Height="120"
                Width="385"
                Canvas.Left="10"
                Canvas.Top="169"
                Background="SaddleBrown"
                BorderBrush="Black"
                BorderThickness="1"
                CornerRadius="30"
                MouseDown="Rect_Antwort1_MouseDown"
                x:Name="Rect_Antwort1">

            <Grid>
                <TextBlock x:Name="Txt_Antwort1"
                           Text="3"
                           Foreground="White"
                           FontSize="24"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="15"/>
            </Grid>
        </Border>

        <!-- Antwort 2 -->
        <Border Height="120"
                Width="385"
                Canvas.Left="405"
                Canvas.Top="169"
                Background="SaddleBrown"
                BorderBrush="Black"
                BorderThickness="1"
                CornerRadius="30"
                MouseDown="Rect_Antwort2_MouseDown"
                x:Name="Rect_Antwort2">

            <Grid>
                <TextBlock x:Name="Txt_Antwort2"
                           Text="4"
                           Foreground="White"
                           FontSize="24"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="15"/>
            </Grid>
        </Border>

        <!-- Antwort 3 -->
        <Border Height="120"
                Width="385"
                Canvas.Left="10"
                Canvas.Top="305"
                Background="SaddleBrown"
                BorderBrush="Black"
                BorderThickness="1"
                CornerRadius="30"
                MouseDown="Rect_Antwort3_MouseDown"
                x:Name="Rect_Antwort3">

            <Grid>
                <TextBlock x:Name="Txt_Antwort3"
                           Text="5"
                           Foreground="White"
                           FontSize="24"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="15"/>
            </Grid>
        </Border>

        <!-- Antwort 4 -->
        <Border Height="120"
                Width="385"
                Canvas.Left="405"
                Canvas.Top="305"
                Background="SaddleBrown"
                BorderBrush="Black"
                BorderThickness="1"
                CornerRadius="30"
                MouseDown="Rect_Antwort4_MouseDown"
                x:Name="Rect_Antwort4">

            <Grid>
                <TextBlock x:Name="Txt_Antwort4"
                           Text="6"
                           Foreground="White"
                           FontSize="24"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="15"/>
            </Grid>
        </Border>

    </Canvas>
</Window>